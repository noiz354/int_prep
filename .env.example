# Browser integration mode. Keep false for the self-contained demo.
# Set true only while `npm run api` is running on the same development host.
VITE_USE_API=false

# API service settings. Never use this development JWT secret in a real deployment.
PORT=8787
AUTH_JWT_SECRET=replace-with-a-rotated-secret-or-an-oidc-integration
ALLOWED_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
OTEL_ENABLED=true
OTEL_SERVICE_NAME=signalroom-api

# Local service ports (unique per SignalRoom; see docker-compose.providers.yml).
VITE_DEV_PORT=5190
VITE_PREVIEW_PORT=4190
AI_PORT=8788
EVENT_GATEWAY_PORT=8789

# Optional local provider adapters (Docker, opt-in). Dev-only values; never use in production.
# Identity: OIDC/SAML/SCIM/MFA
KEYCLOAK_URL=http://localhost:8781
KEYCLOAK_REALM=signalroom
# Data: encrypted MongoDB, KMS, Kafka/Schema Registry, lakehouse
MONGO_URL=mongodb://localhost:8782/signalroom
VAULT_URL=http://localhost:8780
REDPANDA_BROKER=localhost:8790
REDPANDA_SCHEMA_REGISTRY=http://localhost:8791
MINIO_ENDPOINT=http://localhost:8792
# Media: SFU/WebRTC, TURN, recording storage
SFU_URL=http://localhost:8796
TURN_URL=localhost:8797
# AI/RAG: model provider and vector store
# Ollama runs natively on the Windows host (set OLLAMA_HOST=0.0.0.0 on
# Windows). Reach it from WSL via the Windows host gateway IP — verify with
# `ip route show default` and override OLLAMA_URL per machine.
OLLAMA_URL=http://172.24.16.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=granite3.1-dense:2b
QDRANT_URL=http://localhost:8799
# Integrations: mocked ATS/HRIS/calendar/comms OAuth
MOCK_OAUTH_URL=http://localhost:8800
# Delivery: OTel observability
OTLP_ENDPOINT=http://localhost:8785
