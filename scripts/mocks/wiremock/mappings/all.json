{
  "mappings": [
    {
      "name": "OAuth token endpoint (client_credentials)",
      "request": {
        "method": "POST",
        "url": "/oauth/token"
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "access_token": "mock-ats-access-token",
          "token_type": "Bearer",
          "expires_in": 3600,
          "scope": "ats:read ats:write"
        },
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "ATS requisitions list",
      "request": {
        "method": "GET",
        "urlPath": "/ats/v1/requisitions",
        "headers": { "Authorization": { "matches": "Bearer .+" } }
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "requisitions": [
            {
              "id": "req-1001",
              "title": "Staff Software Engineer",
              "status": "open",
              "owner": "eng-hiring-01"
            }
          ]
        },
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "HRIS employee directory",
      "request": {
        "method": "GET",
        "urlPath": "/hris/v1/employees"
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "employees": [
            { "id": "emp-2001", "name": "Ada Reviewer", "role": "interviewer", "active": true }
          ]
        },
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "Calendar free-busy",
      "request": {
        "method": "POST",
        "urlPath": "/calendar/v1/freebusy"
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "windows": [
            { "start": "2026-08-21T02:00:00Z", "end": "2026-08-21T03:00:00Z" }
          ]
        },
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "Comms message send",
      "request": {
        "method": "POST",
        "urlPath": "/comms/v1/messages"
      },
      "response": {
        "status": 201,
        "jsonBody": {
          "message_id": "msg-3001",
          "status": "queued"
        },
        "headers": { "Content-Type": "application/json" }
      }
    },
    {
      "name": "OAuth token introspection",
      "request": {
        "method": "POST",
        "url": "/oauth/introspect"
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "active": true,
          "client_id": "signalroom",
          "scope": "ats:read ats:write hris:read calendar:read comms:write",
          "exp": 4102444800
        },
        "headers": { "Content-Type": "application/json" }
      }
    }
  ]
}
